# Beauty Advisor 环境变量模板
# 使用方法：复制本文件为 .env 并填入真实值

# 阿里云 DashScope（千问）API Key
DASHSCOPE_API_KEY=sk-xxxxxxxx

# 百度智能云人脸检测
BAIDU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
BAIDU_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 千问模型配置（LLM_API_KEY 与 DASHSCOPE_API_KEY 相同即可）
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-max

# 可选：切换本地 LLM（复活 legacy/llm_client.py 时使用）
# LLM_PROVIDER=cloud
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_LLM_MODEL=qwen2.5

# 可选：服务配置
# APP_HOST=127.0.0.1
# APP_PORT=8000
# LOG_LEVEL=INFO
# CORS_ORIGINS=*

# 可选：数据库（默认 SQLite data/beauty_advisor.db）
# DATABASE_URL=sqlite:///F:/looks/beauty-advisor/data/beauty_advisor.db
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/beauty_advisor?charset=utf8mb4
